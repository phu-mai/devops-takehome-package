# Lean toolbox: reuse official CLIs via multi-copy from known images where possible.
FROM alpine:3.20

ARG TARGETARCH=amd64
ARG KUBECTL_VERSION=1.31.4
ARG HELM_VERSION=3.16.4
ARG TERRAFORM_VERSION=1.9.8
ARG K6_VERSION=0.54.0

RUN apk add --no-cache \
      bash curl git jq ca-certificates docker-cli python3 tar gzip unzip openssl \
    && update-ca-certificates

# kubectl
RUN curl -fsSL "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
      -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl

# helm
RUN curl -fsSL "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" \
      | tar -xz -C /tmp \
    && mv "/tmp/linux-${TARGETARCH}/helm" /usr/local/bin/helm \
    && rm -rf /tmp/linux-*

# terraform (slightly older, smaller zip)
RUN curl -fsSL "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${TARGETARCH}.zip" \
      -o /tmp/terraform.zip \
    && unzip /tmp/terraform.zip -d /usr/local/bin \
    && rm /tmp/terraform.zip

# k6
RUN curl -fsSL "https://github.com/grafana/k6/releases/download/v${K6_VERSION}/k6-v${K6_VERSION}-linux-${TARGETARCH}.tar.gz" \
      | tar -xz -C /tmp \
    && mv "/tmp/k6-v${K6_VERSION}-linux-${TARGETARCH}/k6" /usr/local/bin/k6 \
    && rm -rf /tmp/k6-*

# k3d
RUN curl -fsSL https://raw.githubusercontent.com/k3d-io/k3d/main/install.sh | bash

WORKDIR /workspace
ENV KUBECONFIG=/kubeconfig/kubeconfig.yaml
ENV PATH="/usr/local/bin:${PATH}"

CMD ["sleep", "infinity"]
